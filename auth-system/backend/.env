# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://localhost:27017/authdb
# Atlas (replace with your connection string):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/authdb?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
# MUST be at least 32 characters. Generate one:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars

# ─── CORS ─────────────────────────────────────────────────
# In development: http://localhost:5173
# In production: your deployed frontend URL (no trailing slash)
CLIENT_URL=http://localhost:5173
